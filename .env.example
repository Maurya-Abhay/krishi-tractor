# Database (PostgreSQL)
# Use the Supabase Transaction Pooler URL for runtime on Vercel.
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require"
# Use the direct Supabase database URL for Prisma migrations/direct DB access.
DIRECT_URL="postgresql://<DB_USER>:<DB_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Rate limiting (Upstash Redis) — required in production
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Seed admin user (used only by prisma/seed.ts, never hardcode in code)
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_PHONE="9999999999"
SEED_ADMIN_PASSWORD="ChangeMe123!"
